# Example environment variables for Vertex AI training
# Copy this to .env and fill in your values

# Required: GCP Configuration
GCP_PROJECT_ID=your-project-id
GCS_BUCKET=your-bucket-name

# Optional: Experiment Configuration
EXPERIMENT_NAME=default
RUN_ID=

# Optional: Vertex AI Settings
VERTEX_AI_ENABLED=false
MACHINE_TYPE=n1-standard-8
ACCELERATOR_TYPE=NVIDIA_TESLA_T4
ACCELERATOR_COUNT=1

# Optional: Monitoring
USE_TENSORBOARD=true
TENSORBOARD_RESOURCE=
USE_WANDB=false
WANDB_API_KEY=

# Optional: Configuration Overrides (JSON string)
CONFIG_OVERRIDES={}

# Optional: Hyperparameter Search
IS_HYPERPARAM_SEARCH=false
HYPERPARAM_CONFIG=

# Optional: Database Connection (for data extraction)
DATABASE_URL=postgresql://decide@localhost/decide_development
