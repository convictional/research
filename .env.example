# Non-secret configuration for the experiments workspace.
# Copy to `.env` and fill in for your own environment. `.env` is gitignored.
#
# Secrets (API keys, tokens) belong in `.env.secrets`, which is also gitignored.
# See the Makefile for how both are loaded.

# Google Cloud project used for BigQuery and Vertex AI.
GCP_PROJECT=
GCP_LOCATION=us-central1

# Cloud Storage bucket for experiment inputs/outputs.
GCS_BUCKET=

# Local Neo4j instance used by the knowledge-graph experiments.
NEO4J_DSN='bolt://localhost:7687'
NEO4J_USERNAME=neo4j

# OpenAI organization id, if your account requires one.
OPENAI_ORGANIZATION=
